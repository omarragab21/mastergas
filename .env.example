VITE_API_BASE_URL=https://backend-mastergas.be-kite.com/api

# Required in production: an HTTPS backend callback that verifies PayTabs,
# preserves checkout_attempt_id/cart_id, then redirects to the SPA result route.
VITE_PAYTABS_RETURN_URL=

# Optional HTTPS cancellation callback. The SPA failure route is used when
# omitted; neither path is allowed to clear the cart.
VITE_PAYTABS_CANCEL_URL=
