VITE_API_BASE_URL=https://backend-mastergas.be-kite.com/api

# Data source for the dashboard.
#   api   -> EVERY page talks to the live backend (use this for production / hand-over).
#   local -> orders, customers, etc. come from the bundled local snapshot; only the catalogue
#            (categories, products, attributes, discount codes) and login use the live API.
VITE_DATA_MODE=api
